# DepSplit app configuration. Copy to .env and export, or pass through your shell.
# Every variable the CLI reads is listed here. Nothing here is a secret except DEPSPLIT_SECRET.

# Soroban RPC endpoint and network passphrase (defaults: Stellar testnet).
SOROBAN_RPC_URL=https://soroban-testnet.stellar.org
NETWORK_PASSPHRASE="Test SDF Network ; September 2015"

# Deployed split_router contract id (C...). Printed by scripts/deploy-testnet.sh. Empty until deployed.
DEPSPLIT_CONTRACT_ID=

# USDC Stellar Asset Contract id (C...) on the chosen network.
# Testnet: derive it from the testnet USDC issuer with
#   stellar contract id asset --network testnet --asset USDC:GBBD47IF6LWK7P7MDEVSCWR7DPUWV3NY3DTQEVFL4NAT4AQH3ZLLFLA5
# (verify the issuer against the anchor/issuer you actually intend to use before paying real value).
USDC_CONTRACT_ID=

# Secret key (S...) of the account signing this CLI's transactions:
#   register/update-splits -> the project owner; pay -> the payer; withdraw -> the recipient.
# Never commit a real key. Testnet keys come from `stellar keys generate --fund`.
DEPSPLIT_SECRET=

# Public key used as the simulation source for read-only views when no secret is set.
DEPSPLIT_VIEWER=

# Local files (paths are relative to where you run the CLI; defaults are under <project>/data/).
# Registry cache: slug -> on-chain id and every table version (written by register/update-splits).
DEPSPLIT_REGISTRY=./data/registry.json
# The payer's own payments log, appended by `depsplit pay` and read by `depsplit statement`.
DEPSPLIT_PAYMENTS=./data/payments.csv
